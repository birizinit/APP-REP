{
  "name": "representei",
  "version": "0.1.0",
  "private": true,
  "description": "Representei — o talao digital do representante comercial",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "vapid": "node scripts/gen-vapid.mjs",
    "postinstall": "prisma generate",
    "db:local": "node scripts/db-local.mjs",
    "db:local:stop": "node scripts/db-local.mjs stop",
    "db:local:clean": "node scripts/db-local.mjs clean",
    "setup": "npm run db:push && npm run db:seed",
    "preview": "node scripts/preview.mjs",
    "icones": "node scripts/gen-icones.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "jose": "^5.9.6",
    "leaflet": "^1.9.4",
    "next": "^15.1.6",
    "papaparse": "^5.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "unpdf": "^0.12.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.10.5",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "postcss": "^8.5.1",
    "prisma": "^6.1.0",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}

# ---------------------------------------------------------------
# Representei — variaveis de ambiente
# Copie para .env e preencha.
# ---------------------------------------------------------------

# Banco (Railway -> Postgres -> Connect -> DATABASE_URL)
DATABASE_URL="postgresql://postgres:senha@localhost:5432/representei?schema=public"

# Segredo para assinar a sessao (gere com: openssl rand -base64 48)
AUTH_SECRET="troque-isso-por-uma-string-longa-e-aleatoria-de-no-minimo-32-chars"

# URL publica do app (usada nas notificacoes push)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Notificacoes push (Web Push / VAPID) ---
# Gere com: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@seudominio.com.br"

# --- Roteirizador ---
# Sem nenhuma chave o sistema usa OSRM publico (gratis) e cai para
# calculo haversine se a rede falhar. Colocando a chave do Google,
# ele passa a usar Directions + Distance Matrix automaticamente.
GOOGLE_MAPS_API_KEY=""
OSRM_BASE_URL="https://router.project-osrm.org"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="Representei/0.1 (contato@seudominio.com.br)"

# --- Consulta de CNPJ ---
# BrasilAPI e publica e nao exige chave. Deixe como esta.
CNPJ_PROVIDER="brasilapi"

# Codigo de convite para abrir o cadastro depois que a primeira conta
# existir. Deixe vazio para manter o cadastro fechado (recomendado num
# app de um representante so publicado numa URL publica).
CONVITE=""

# Cron interno das notificacoes (protege /api/cron/*)
CRON_SECRET="troque-tambem"
